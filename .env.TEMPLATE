# ============================================================================
# MAIA Upgrades - .env.TEMPLATE (SOMENTE PLACEHOLDERS)
# ----------------------------------------------------------------------------
# Este pacote de upgrade NAO exige .env proprio. O fluxo padrao (skills +
# agentes) nao usa nenhuma chave. As variaveis abaixo so importam para o
# caminho OPCIONAL --with-memory, e ja vivem no .env da BASE MAIA
# (/opt/MAIA/bot/.env) - nao duplique segredos aqui.
#
# NUNCA comite valores reais neste arquivo. Preencha no .env da base.
# ============================================================================

# Usado pela memoria semantica (--with-memory) para gerar embeddings Gemini.
GEMINI_API_KEY=

# Onde a base MAIA esta instalada (usado so pelo install-memory.sh).
MAIA_HOME=/opt/MAIA
MAIA_USER=maia
