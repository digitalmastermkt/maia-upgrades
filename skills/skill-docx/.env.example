# skill-docx - variaveis opcionais
# Por padrao a skill puxa marca/autor/site/contato do sistema central
# (/opt/MAIA/brand/brand.json via brand_loader). Preencha abaixo APENAS se
# quiser sobrescrever sem passar via CLI. Vazio = usa o brand_loader.

DOCX_DEFAULT_AUTHOR=""
DOCX_DEFAULT_BRAND=""
DOCX_DEFAULT_EMAIL=""
DOCX_DEFAULT_SITE=""

# Caminhos de fontes (informativo - python-docx usa nome de fonte, nao path)
FONT_DISPLAY_PATH="/opt/MAIA/assets/fonts/playfair_display"
FONT_BODY_PATH="/opt/MAIA/assets/fonts/plus_jakarta"
FONT_MONO_PATH="/opt/MAIA/assets/fonts/jetbrains_mono"
